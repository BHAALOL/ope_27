# ===========================================
# Présidentielle 2027 - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values.

# --- Database (required) ---
DATABASE_URL="postgresql://postgres:postgres2027@localhost:5432/presidentielle2027"

# --- NextAuth (required) ---
# Generate a strong secret: openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_ME_TO_A_RANDOM_SECRET"
NEXTAUTH_URL="http://localhost:3000"

# --- Admin seed password (optional, default: admin2027!) ---
ADMIN_PASSWORD="your-secure-admin-password"

# --- AI Providers (optional) ---
# Anthropic (default provider)
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-sonnet-4-20250514"

# OpenAI (alternative provider)
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o"

# Perplexity (news search)
PERPLEXITY_API_KEY="pplx-..."
PERPLEXITY_MODEL="sonar-pro"

# --- Docker / Production ---
POSTGRES_PASSWORD="your-secure-postgres-password"
NODE_ENV="development"
