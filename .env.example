# ===========================================
# Présidentielle 2027 - Configuration
# ===========================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- Database ---
DATABASE_URL="postgresql://postgres:password@localhost:5432/presidentielle2027"

# --- NextAuth ---
# REQUIRED: Secret for signing tokens (min 32 chars)
# Generate with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-min-32-chars-change-in-production"

# --- Public Site URL (for sitemap, robots.txt, OpenGraph) ---
NEXT_PUBLIC_SITE_URL="https://presidentielle2027.fr"

# --- AI Providers (optional, leave empty to disable) ---
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-20250514"

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1"

PERPLEXITY_API_KEY=""
PERPLEXITY_MODEL="sonar-pro"

# --- Admin seed password (change in production!) ---
ADMIN_PASSWORD="your-secure-admin-password"

# --- Docker Compose ---
POSTGRES_PASSWORD="your-secure-postgres-password"

# --- Node environment ---
NODE_ENV="development"
