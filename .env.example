# =============================================================================
# Required variables
# =============================================================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/presidentielle2027"

# NextAuth (REQUIRED)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""  # Generate with: openssl rand -base64 32

# Admin seed password (REQUIRED for db:seed)
ADMIN_PASSWORD=""

# Docker Compose
POSTGRES_PASSWORD=""

# =============================================================================
# Optional variables (AI features)
# =============================================================================

# Anthropic Claude API
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-20250514"

# OpenAI GPT API
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1"

# Perplexity API (real-time news search)
PERPLEXITY_API_KEY=""
PERPLEXITY_MODEL="sonar-pro"

# =============================================================================
# Optional configuration
# =============================================================================

# Additional trusted image domains (comma-separated)
NEXT_PUBLIC_ALLOWED_IMAGE_DOMAINS=""

# Node environment
NODE_ENV="development"

# App port for Docker (default: 3000)
APP_PORT="3000"
